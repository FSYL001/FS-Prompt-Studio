{
  "name": "prompt-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Prompt Studio - 中文优先的 AI 生图提示词编辑器（本地优先 + 可配置翻译服务）",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:smoke": "node scripts/e2e-smoke.mjs",
    "e2e:flows": "node scripts/e2e-flows.mjs",
    "e2e:failure": "node scripts/e2e-failure.mjs",
    "docs:screenshots": "node scripts/docs-screenshots.mjs"
  },
  "dependencies": {
    "express": "^4.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
